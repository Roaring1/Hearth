+
+  # Only send hardware LED feedback if explicitly enabled for a compatible unit.
+  # For the classic LPD8, still seed Hearth's software toggle state from real mutes.
+  if [[ "$LED_FEEDBACK_SUPPORTED" == "1" ]]; then
+    local spec pad state
+    for spec in "1:$s1" "2:$s2" "3:0" "4:$s4" "5:0" "6:$s6" "7:$s7" "8:0"; do
+      pad="${spec%%:*}"
+      state="${spec#*:}"
+      if ! lpd8_led_set "$pad" "$state"; then
+        _lpd8_amidi_port=""
