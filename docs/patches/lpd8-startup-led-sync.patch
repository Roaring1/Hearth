-      led_synced=1
+    # Retry startup/reconnect LED initialization until every write is accepted.
+    # Previously a missing raw port or failed amidi write was silently treated
+    # as success, leaving LEDs dark until a pad was physically pressed.
+    local led_now
+    led_now="$(now_ms)"
+    if (( led_synced == 0 )) && pads_enabled && (( led_now - led_sync_retry_ms >= 1000 )); then
