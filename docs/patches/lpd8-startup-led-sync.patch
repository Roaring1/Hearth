-  local s2; s2="$(_sink_led_state "$SINK_CHAT")"
-  local s4; s4="$(_sink_led_state "$ASTRO_TARGET")"
-  local mic; mic="$(detect_mic_source)"
-  local s6; s6="$(_src_led_state "$mic")"
-  local s7; s7="$(_sink_led_state "$SINK_GAME")"
-
-  lpd8_led_set 1 "$s1"
-  lpd8_led_set 2 "$s2"
-  lpd8_led_set 3 0      # action pad — starts dark
-  lpd8_led_set 4 "$s4"
-  lpd8_led_set 5 0      # action pad — starts dark
-  lpd8_led_set 6 "$s6"
-  lpd8_led_set 7 "$s7"
-  lpd8_led_set 8 0      # action pad — starts dark
+  local s1 s2 s4 s6 s7 mic
+  if ! s1=$(_sink_led_state "$SINK_MUSIC"); then
+    log_led_sync_retry "could not read Music mute state"
+    return 1
+  fi
+  if ! s2=$(_sink_led_state "$SINK_CHAT"); then
+    log_led_sync_retry "could not read Chat mute state"
+    return 1
+  fi
+  if ! s4=$(_sink_led_state "$ASTRO_TARGET"); then
+    log_led_sync_retry "could not read headset mute state"
+    return 1
+  fi
+  mic="$(detect_mic_source)" || mic=""
+  if [[ -z "$mic" ]] || ! s6=$(_src_led_state "$mic"); then
+    log_led_sync_retry "could not read microphone mute state"
+    return 1
+  fi
+  if ! s7=$(_sink_led_state "$SINK_GAME"); then
+    log_led_sync_retry "could not read Game mute state"
+    return 1
+  fi
+
+  # If any write fails, leave sync pending and retry the entire snapshot.
+  # Action pads always start dark; state pads show actual mute status.
+  local spec pad state
+  for spec in "1:$s1" "2:$s2" "3:0" "4:$s4" "5:0" "6:$s6" "7:$s7" "8:0"; do
+    pad="${spec%%:*}"
+    state="${spec#*:}"
+    if ! lpd8_led_set "$pad" "$state"; then
+      _lpd8_amidi_port=""
+      log_led_sync_retry "MIDI write failed on pad $pad"
+      return 1
+    fi
+  done
